	<string>La posizione serve per verificare che tu sia nei pressi del negozio quando timbri e per segnalare eventuali uscite dalla zona senza timbratura.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Il monitoraggio della zona negozio continua in background mentre sei in servizio (dopo entrata e fino all'uscita), per registrare eventuali allontanamenti senza timbratura.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Il monitoraggio della zona negozio continua in background mentre sei in servizio.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>location-services</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
